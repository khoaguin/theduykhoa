      "fontSize": 21.22662398387401,
      "fontFamily": 8,
      "text": "Bob's key bundle: \n  1. Identity key: IKB (public)\n  2. Signed prekey: SPKB + signature\n  3. PQ last-resort prekey: \n        PQSPKB + signature\n ",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bob's key bundle: \n  1. Identity key: IKB (public)\n  2. Signed prekey: SPKB + signature\n  3. PQ last-resort prekey: \n        PQSPKB + signature\n ",
      "lineHeight": 1.25,
      "baseline": 14,
      "index": "a7",
      "autoResize": true
    },
