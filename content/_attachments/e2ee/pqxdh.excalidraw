    },
    {
      "id": "sMarisUATELimdZFTv4g7",
      "type": "text",
      "x": -455.8341518095349,
      "y": -1082.7407797220521,
      "width": 1186.1561341048914,
      "height": 121.94480472315722,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d0bfff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5C6UtFgyAgAed82zD_t5z"
      ],
      "frameId": null,
