      "link": null,
      "locked": false,
      "text": "DH calculations between keys\n• DH1 and DH2 provide mutual authentication\n• DH3 and DH4 provide forward secrecy",
      "fontSize": 9.68300732307688,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DH calculations between keys\n• DH1 and DH2 provide mutual authentication\n• DH3 and DH4 provide forward secrecy",
