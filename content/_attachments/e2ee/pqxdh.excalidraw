      "seed": 61831346,
      "version": 1268,
      "versionNonce": 733733938,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763130775286,
      "link": null,
      "locked": false,
      "text": "PQXDH is an evolution of X3DH that adds post-quantum forward secrecy\na form of cryptographic deniability while maintaining the core protocol\nstructure.",
      "fontSize": 32.51861459284193,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PQXDH is an evolution of X3DH that adds post-quantum forward secrecy a form of cryptographic deniability while maintaining the core protocol structure.",
      "autoResize": false,
      "lineHeight": 1.25
    },
