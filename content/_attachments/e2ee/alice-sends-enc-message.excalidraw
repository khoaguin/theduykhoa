      "updated": 1763305183517,
      "link": null,
      "locked": false,
      "text": "The message contains:\n• Alice’s identity public key IKA\n• Alice’s ephemeral public key EKA\n• The pqkem ciphertext CT encapsulating SS for PQPKB\n• enc_message = AEAD-Enc(\n    key=SK, associated_data=AD, data=plaintext_data\n  )",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The message contains:\n• Alice’s identity public key IKA\n• Alice’s ephemeral public key EKA\n• The pqkem ciphertext CT encapsulating SS for PQPKB\n• enc_message = AEAD-Enc(\n    key=SK, associated_data=AD, data=plaintext_data\n  )",
      "autoResize": true,
      "lineHeight": 1.25
